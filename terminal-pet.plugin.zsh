# Entry point for zsh plugin managers (zinit, antigen, zplug, oh-my-zsh custom plugins, ...):
#   zinit light Zezoo123/terminal-pet
#   antigen bundle Zezoo123/terminal-pet
# The app itself still needs to be installed (brew install Zezoo123/tap/terminal-pet, or make install).
source "${0:A:h}/shell/terminal-pet.plugin.zsh"
